# Örnek env dosyası. Kopyala -> .env yap, değerleri doldur.
# cp .env.example .env

# Brevo API anahtarı (xkeysib-... ile başlar)
BREVO_API_KEY=

# Brevo'da doğrulanmış gönderici adresi
NUXT_CONTACT_FROM_EMAIL=info@egekardoor.com

# Form taleplerinin gideceği adres
NUXT_CONTACT_TO_EMAIL=ucucsifir@gmail.com

# Gönderen görünen ad
NUXT_CONTACT_FROM_NAME=Kardoor Website
